menu "FakePod Wi-Fi RTP audio test"

config FAKEPOD_WIFI_RTP_TEST_ENABLE
    bool "Enable RTP L24 audio streaming to a PC"
    default n
    help
        Sends decoded music PCM to a Windows/Linux RTP receiver for
        wireless audio validation. Disabled in normal firmware builds.

# Retained as a hidden legacy symbol so existing generated sdkconfig files
# remain readable. The sender now discovers the receiver automatically.
config FAKEPOD_WIFI_RTP_TEST_TARGET_IP
    string
    default ""
    depends on FAKEPOD_WIFI_RTP_TEST_ENABLE

config FAKEPOD_WIFI_RTP_TEST_DISCOVERY_PORT
    int "RTP receiver discovery UDP port"
    range 1024 65535
    default 5005
    depends on FAKEPOD_WIFI_RTP_TEST_ENABLE
    help
        UDP port used by the FakePod receiver discovery request/response.

config FAKEPOD_WIFI_RTP_TEST_PORT
    int "RTP receiver UDP port"
    range 1024 65535
    default 5004
    depends on FAKEPOD_WIFI_RTP_TEST_ENABLE
    help
        UDP port used for RTP L24 audio packets.

endmenu
