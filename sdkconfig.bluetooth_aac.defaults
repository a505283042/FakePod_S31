# FakePod S31 Bluetooth dual-mode profile (ESP-IDF 6.1)
# Preserve Android encrypted BLE GATT remote while sending audio over Classic A2DP.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y

# S31 controller has an INDEPENDENT mode choice (default BLE Only).
# Enabling Bluedroid Classic/A2DP below does NOT switch that choice.
# If this stays BLE Only, esp_bluedroid_enable() may wait forever for Classic HCI.
CONFIG_BTDM_CTRL_MODE_BTDM=y
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY is not set
# CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY is not set

# Experimental receive-only profile: Bluedroid passes undecoded SBC/AAC
# to FakePod's worker; existing A2DP Source PCM encoder is not available here.
# Select env:fakepod_s31_aac. Default SBC environment stays unchanged.
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_A2DP_CODEC_AAC_ENABLED=y
CONFIG_BT_A2DP_SEP_NUM_MAX=2

# Android GATT remote service: BLE 4.2 GATTS and encrypted bonding.
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y

# AVRCP 1.6 BIP/OBEX Cover Art client (independent of SBC/AAC codec).
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=y
